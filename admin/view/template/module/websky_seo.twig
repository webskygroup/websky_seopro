{{ header }}{{ column_left }}
<style>
.wsseo{--ws:#2563eb;max-width:1500px}.wsseo .card{border:0;box-shadow:0 8px 30px rgba(15,23,42,.07);border-radius:14px}.wsseo .nav-tabs{gap:4px;border-bottom:0;margin-bottom:18px}.wsseo .nav-tabs .nav-link{border:0;border-radius:9px;font-weight:600}.wsseo .nav-tabs .nav-link.active{background:#e9f1ff;color:var(--ws)}.wsseo textarea{min-height:86px}.wsseo .metric{border-radius:12px;padding:16px;background:#f8fafc;border:1px solid #e8edf5}.wsseo .metric strong{display:block;font-size:1.35rem;color:#172033}.wsseo .table td,.wsseo .table th{vertical-align:middle}.wsseo[dir=rtl] .form-label{text-align:right}.wsseo .code{font-family:ui-monospace,Consolas,monospace;direction:ltr;text-align:left}
/* Keep the SEO page inside the RTL admin content area when the side menu is visible. */
#content.wsseo {
  box-sizing: border-box;
  width: auto;
  max-width: none;
  min-width: 0;
  overflow-x: hidden;
}
#content.wsseo > .page-header > .container-fluid,
#content.wsseo > .container-fluid {
  width: 100%;
  max-width: 1500px;
  margin-right: auto;
  margin-left: auto;
}
@media (min-width: 992px) {
  #column-left + #content.wsseo,
  #column-left.active + #content.wsseo {
    right: 0;
    margin-right: 235px;
    margin-left: 0;
  }
}
@media (max-width: 991.98px) {
  #content.wsseo {
    width: 100%;
  }
  #content.wsseo > .page-header > .container-fluid,
  #content.wsseo > .container-fluid {
    padding-right: 12px;
    padding-left: 12px;
  }
}
</style>
<div id="content" class="wsseo">
  <div class="page-header"><div class="container-fluid"><div class="float-end"><button type="submit" form="wsseo-settings" class="btn btn-primary"><i class="fa-solid fa-save"></i> {{ text_save }}</button><a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i> {{ button_back }}</a></div><h1><i class="fa-solid fa-chart-line"></i> {{ heading_title }}</h1><ol class="breadcrumb">{% for breadcrumb in breadcrumbs %}<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>{% endfor %}</ol></div></div>
  <div class="container-fluid">
    <div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_features }} <span class="float-end">v{{ version }}</span></div>
    <div class="card"><div class="card-body">
      <ul class="nav nav-tabs" role="tablist"><li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-settings">{{ text_settings }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-update">{{ tab_update }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-ai">{{ text_ai }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-editor">{{ text_editor }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-generator">{{ text_generator }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-redirects">{{ text_redirects }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-links">{{ text_links }}</a></li><li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-reports">{{ text_reports }}</a></li></ul>
      <div class="tab-content">
        <div class="tab-pane fade" id="tab-update"><div class="row g-3 mb-3"><div class="col-md-4"><div class="metric h-100"><span>{{ text_current_version }}</span><strong>{{ current_version }}</strong></div></div><div class="col-md-4"><div class="metric h-100"><span>{{ text_latest_version }}</span><strong>{{ latest_version ?: '—' }}</strong></div></div><div class="col-md-4"><div class="metric h-100"><span>{{ text_date_added }}</span><strong>{{ date_added ?: '—' }}</strong></div></div></div><div class="border rounded p-3 mb-3"><strong>{{ text_change_log }}</strong><div class="mt-2">{{ change_log ?: '—' }}</div></div>{% if version_error %}<div class="alert alert-warning">{{ version_error }}</div>{% endif %}<div class="input-group input-group-lg mt-3"><button type="button" id="wsseo-update" class="btn btn-primary" data-url="{{ download }}"{% if not upgrade %} disabled{% endif %}><i class="fa-solid fa-cloud-arrow-down"></i> {{ button_update }}</button><input type="text" id="wsseo-update-status" value="{% if upgrade %}{{ text_update_ready }}{% elseif version_error %}{{ version_error }}{% else %}{{ text_up_to_date }}{% endif %}" class="form-control bg-white" readonly></div></div>
        <div class="tab-pane fade show active" id="tab-settings"><form id="wsseo-settings" action="{{ save|raw }}" method="post" data-oc-toggle="ajax"><div class="row g-3"><div class="col-md-4"><label class="form-label">{{ entry_status }}</label><select name="status" class="form-select"><option value="1"{% if settings.status %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.status %} selected{% endif %}>Disabled</option></select></div><div class="col-md-4"><label class="form-label">{{ entry_robots }}</label><select name="robots_default" class="form-select"><option value="index,follow"{% if settings.robots_default == 'index,follow' %} selected{% endif %}>index,follow</option><option value="noindex,follow"{% if settings.robots_default == 'noindex,follow' %} selected{% endif %}>noindex,follow</option><option value="noindex,nofollow"{% if settings.robots_default == 'noindex,nofollow' %} selected{% endif %}>noindex,nofollow</option></select></div><div class="col-md-4"><label class="form-label">{{ entry_daily_limit }}</label><input name="ai_daily_limit" type="number" min="1" max="1000" class="form-control" value="{{ settings.ai_daily_limit }}"></div></div><hr><div class="row g-3"><div class="col-md-3"><label class="form-label">Friendly SEO URLs</label><select name="urls" class="form-select"><option value="1"{% if settings.urls %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.urls %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Canonical</label><select name="canonical" class="form-select"><option value="1"{% if settings.canonical %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.canonical %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Hreflang</label><select name="hreflang" class="form-select"><option value="1"{% if settings.hreflang %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.hreflang %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">JSON-LD</label><select name="schema" class="form-select"><option value="1"{% if settings.schema %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.schema %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Social cards</label><select name="social" class="form-select"><option value="1"{% if settings.social %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.social %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Language subfolders</label><select name="language_prefix" class="form-select"><option value="1"{% if settings.language_prefix %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.language_prefix %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Trailing slash</label><select name="trailing_slash" class="form-select"><option value="1"{% if settings.trailing_slash %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.trailing_slash %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Auto internal links</label><select name="internal_links" class="form-select"><option value="1"{% if settings.internal_links %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.internal_links %} selected{% endif %}>Disabled</option></select></div><div class="col-md-3"><label class="form-label">Log 404</label><select name="log_404" class="form-select"><option value="1"{% if settings.log_404 %} selected{% endif %}>Enabled</option><option value="0"{% if not settings.log_404 %} selected{% endif %}>Disabled</option></select></div></div><hr><div class="row g-3"><div class="col-md-6"><div class="input-group"><span class="input-group-text">{{ text_sitemap }}</span><a class="form-control text-decoration-none" href="{{ sitemap }}" target="_blank">{{ sitemap }}</a></div></div><div class="col-md-6"><div class="input-group"><span class="input-group-text">{{ text_robots }}</span><a class="form-control text-decoration-none" href="{{ robots }}" target="_blank">{{ robots }}</a></div></div></div></form></div>
        <div class="tab-pane fade" id="tab-ai"><form id="wsseo-ai-settings" action="{{ save|raw }}" method="post" data-oc-toggle="ajax"><div class="row g-3"><div class="col-md-8"><label class="form-label">{{ entry_api_key }}</label><input type="password" name="module_websky_seo_ai_api_key" class="form-control" autocomplete="new-password" placeholder="sk-..."><small class="text-muted">{{ text_api_key_help }}</small></div><div class="col-md-4"><label class="form-label">{{ entry_model }}</label><input name="ai_model" class="form-control" value="{{ settings.ai_model }}"></div><div class="col-12"><label class="form-label">{{ entry_instructions }}</label><textarea name="ai_instructions" class="form-control">{{ settings.ai_instructions }}</textarea><small class="text-muted">{{ text_openai_help }}</small></div></div><input type="hidden" name="status" value="{{ settings.status }}"></form></div>
        <div class="tab-pane fade" id="tab-editor"><div class="row g-3 align-items-end"><div class="col-md-2"><label class="form-label">{{ entry_store }}</label><select id="ws-store" class="form-select">{% for store in stores %}<option value="{{ store.store_id }}"{% if store.store_id == selected_store %} selected{% endif %}>{{ store.name }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label">{{ entry_language }}</label><select id="ws-language" class="form-select">{% for language in languages %}<option value="{{ language.language_id }}"{% if language.language_id == selected_language %} selected{% endif %}>{{ language.name }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label">{{ entry_type }}</label><select id="ws-type" class="form-select">{% for type in types %}<option value="{{ type }}">{{ type|capitalize }}</option>{% endfor %}</select></div><div class="col-md-2"><label class="form-label">{{ entry_entity_id }}</label><input id="ws-id" type="number" min="0" class="form-control" value="{{ selected_entity_id }}"></div><div class="col-md-4"><button id="ws-load" class="btn btn-outline-primary">{{ text_load }}</button> <button id="ws-ai" class="btn btn-primary">{{ text_generate_ai }}</button></div></div><div id="ws-editor-message" class="mt-3"></div><div id="ws-editor" class="row g-3 mt-1"></div></div>
        <div class="tab-pane fade" id="tab-generator"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">{{ entry_type }}</label><select id="ws-gen-type" class="form-select">{% for type in types %}<option value="{{ type }}">{{ type|capitalize }}</option>{% endfor %}</select></div><div class="col-md-3"><button id="ws-generate" class="btn btn-primary">{{ text_generate }}</button> <button id="ws-audit" class="btn btn-outline-primary">{{ text_audit }}</button></div></div><div id="ws-generator-result" class="mt-3"></div></div>
        <div class="tab-pane fade" id="tab-redirects"><form id="ws-redirect-form" class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">{{ entry_source }}</label><input name="source" class="form-control code" placeholder="/old-page"></div><div class="col-md-4"><label class="form-label">{{ entry_target }}</label><input name="target" class="form-control code" placeholder="/new-page"></div><div class="col-md-2"><label class="form-label">{{ entry_code }}</label><select name="code" class="form-select"><option>301</option><option>302</option><option>307</option><option>308</option></select></div><div class="col-md-2"><button class="btn btn-primary w-100">{{ text_save }}</button></div></form><div id="ws-redirect-result" class="mt-3"></div><div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>{{ entry_source }}</th><th>{{ entry_target }}</th><th>{{ entry_code }}</th><th>Hits</th></tr></thead><tbody>{% for redirect in redirects %}<tr><td class="code">{{ redirect.source }}</td><td class="code">{{ redirect.target }}</td><td>{{ redirect.code }}</td><td>{{ redirect.hits }}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">No redirects yet.</td></tr>{% endfor %}</tbody></table></div></div>
        <div class="tab-pane fade" id="tab-links"><form id="ws-link-form" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">{{ entry_word }}</label><input name="keyword" class="form-control"></div><div class="col-md-4"><label class="form-label">{{ entry_link }}</label><input name="target" class="form-control code" placeholder="/category/example"></div><div class="col-md-3"><label class="form-label">{{ entry_tooltip }}</label><input name="tooltip" class="form-control"></div><div class="col-md-2"><button class="btn btn-primary w-100">{{ text_save }}</button></div></form><div id="ws-link-result" class="mt-3"></div></div>
        <div class="tab-pane fade" id="tab-reports"><div class="row g-3 mb-3"><div class="col-md-4"><div class="metric"><span>404 / logs</span><strong>{{ reports.logs|length }}</strong></div></div><div class="col-md-4"><div class="metric"><span>History</span><strong>{{ reports.history|length }}</strong></div></div><div class="col-md-4"><div class="metric"><span>AI today</span><strong>{{ reports.ai|length }}</strong></div></div></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Kind</th><th>Path</th><th>Bot</th><th>Hits</th><th>Updated</th></tr></thead><tbody>{% for log in reports.logs %}<tr><td>{{ log.kind }}</td><td class="code">{{ log.path }}</td><td>{{ log.bot }}</td><td>{{ log.hits }}</td><td>{{ log.date_modified }}</td></tr>{% else %}<tr><td colspan="5" class="text-muted">No logs yet.</td></tr>{% endfor %}</tbody></table></div></div>
      </div>
    </div></div>
  </div>
</div>
<script>
(function($){
  // OpenCart returns HTML-safe URLs with &amp; for server-rendered attributes.
  // These values are consumed by JavaScript, so normalize them before every AJAX call.
  function endpoint(url){return String(url).replace(/&amp;/g,'&');}
  const urls={entity:endpoint('{{ entity|raw }}'),ai:endpoint('{{ ai|raw }}'),save:endpoint('{{ entity_save|raw }}'),clear:endpoint('{{ clear|raw }}'),generate:endpoint('{{ generate|raw }}'),audit:endpoint('{{ audit|raw }}'),redirect:endpoint('{{ redirect_save|raw }}'),link:endpoint('{{ link_save|raw }}')};
  $('#wsseo-update').on('click',function(){let b=$(this),s=$('#wsseo-update-status');b.prop('disabled',true);s.val('{{ text_update_ready|escape('js') }}');$.getJSON(endpoint(b.data('url'))).done(function(r){if(r.error){s.val(r.error);b.prop('disabled',false);return;}s.val(r.success||'{{ text_update_success|escape('js') }}');setTimeout(function(){window.location.reload();},900);}).fail(function(){s.val('{{ error_update|escape('js') }}');b.prop('disabled',false);});});
  const fields=['meta_title','meta_description','meta_keyword','tag','h1','h2','image_alt','image_title','robots','description','keyword'];
  let entity=null;
  function payload(extra){return Object.assign({store_id:$('#ws-store').val(),language_id:$('#ws-language').val(),type:$('#ws-type').val(),entity_id:$('#ws-id').val()},extra||{});}
  function message(text,ok){$('#ws-editor-message').html('<div class="alert alert-'+(ok?'success':'danger')+'">'+String(text).replace(/[<>]/g,'')+'</div>');}
  function render(data){entity=data;let html='';fields.forEach(function(f){html+='<div class="col-md-'+(f==='description'||f==='meta_description'?'12':'6')+'"><label class="form-label">'+f.replaceAll('_',' ')+'</label><textarea class="form-control ws-field" data-field="'+f+'">'+(data[f]||'')+'</textarea></div>';});html+='<div class="col-12"><button id="ws-save-record" class="btn btn-success">{{ text_save_record }}</button> <button id="ws-clear-record" class="btn btn-outline-danger">{{ text_clear }}</button> <span class="text-muted ms-2">Score: '+(data.audit?data.audit.score:'-')+'</span></div>';$('#ws-editor').html(html);}
  function load(){ $.getJSON(urls.entity+'&store_id='+$('#ws-store').val()+'&language_id='+$('#ws-language').val()+'&type='+$('#ws-type').val()+'&entity_id='+$('#ws-id').val()).done(function(r){if(r.entity)render(r.entity);else message(r.error||'Not found',false);}).fail(function(x){message(x.responseJSON&&x.responseJSON.error||'Request failed',false);}); }
  $('#ws-load').on('click',function(e){e.preventDefault();load();});
  $('#ws-ai').on('click',function(e){e.preventDefault();if(!entity){message('Load a record first',false);return;}let b=$(this).prop('disabled',true);$.post(urls.ai,JSON.stringify(payload()),null,'json').done(function(r){if(r.success){Object.assign(entity,r.data);render(entity);message('AI preview ready. Review and save.',true);}else message(r.error,false);}).fail(function(x){message(x.responseJSON&&x.responseJSON.error||'AI request failed',false);}).always(function(){b.prop('disabled',false);});});
  $(document).on('click','#ws-save-record',function(){let f={};$('.ws-field').each(function(){f[$(this).data('field')]=$(this).val();});$.post(urls.save,JSON.stringify(payload({fields:f,etag:entity.etag})),null,'json').done(function(r){if(r.success){render(r.entity);message('Saved',true);}else message(r.error,false);}).fail(function(x){message(x.responseJSON&&x.responseJSON.error||'Save failed',false);});});
  $(document).on('click','#ws-clear-record',function(){if(!entity)return;$.post(urls.clear,JSON.stringify(payload({fields:fields})),null,'json').done(function(r){if(r.success){render(r.entity);message('Cleared',true);}else message(r.error,false);});});
  $('#ws-generate').on('click',function(){let b=$(this).prop('disabled',true),after=0,count=0;function step(){ $.post(urls.generate,JSON.stringify({type:$('#ws-gen-type').val(),store_id:$('#ws-store').val(),language_id:$('#ws-language').val(),after:after,limit:25}),null,'json').done(function(r){if(!r.success){$('#ws-generator-result').html('<div class="alert alert-danger">'+r.error+'</div>');b.prop('disabled',false);return;}count+=r.changed;after=r.next;if(r.has_more)step();else{$('#ws-generator-result').html('<div class="alert alert-success">Generated '+count+' records.</div>');b.prop('disabled',false);}}).fail(function(){b.prop('disabled',false);});}step();});
  $('#ws-audit').on('click',function(){let b=$(this).prop('disabled',true);$.getJSON(urls.audit+'&type='+$('#ws-gen-type').val()+'&store_id='+$('#ws-store').val()+'&language_id='+$('#ws-language').val()).done(function(r){$('#ws-generator-result').html('<div class="alert alert-info">Average score: <strong>'+r.average+'</strong> / 100 — records: '+r.total+' — issues: '+JSON.stringify(r.issues)+'</div>');}).always(function(){b.prop('disabled',false);});});
  $('#ws-redirect-form').on('submit',function(e){e.preventDefault();$.post(urls.redirect,$(this).serialize(),null,'json').done(function(r){$('#ws-redirect-result').html('<div class="alert alert-'+(r.success?'success':'danger')+'">'+(r.success?'Saved':r.error)+'</div>');});});
  $('#ws-link-form').on('submit',function(e){e.preventDefault();$.post(urls.link,$(this).serialize(),null,'json').done(function(r){$('#ws-link-result').html('<div class="alert alert-'+(r.success?'success':'danger')+'">'+(r.success?'Saved':r.error)+'</div>');});});
})(jQuery);
</script>
{{ footer }}
